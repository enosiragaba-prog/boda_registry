<%- include('../partials/header', { title }) %><div class="page-heading"><div><div class="eyebrow">ROAD SAFETY OVERVIEW</div><h1>Public accident statistics</h1><p>Aggregated information only. Individual reports and identities are kept private.</p></div></div><div class="metric-card mb-4"><div class="metric-label">Total recorded accidents</div><div class="metric-value"><%= total %></div></div><div class="row g-3"><div class="col-lg-6"><div class="panel-card"><h2>By severity</h2><% if (!bySeverity.length) { %><p class="text-muted">No data available.</p><% } %><% bySeverity.forEach(x => { %><div class="bar-row"><span><%= x._id %></span><strong><%= x.total %></strong></div><% }) %></div></div><div class="col-lg-6"><div class="panel-card"><h2>By district</h2><% if (!byDistrict.length) { %><p class="text-muted">No data available.</p><% } %><% byDistrict.forEach(x => { %><div class="bar-row"><span><%= x._id %></span><strong><%= x.total %></strong></div><% }) %></div></div><div class="col-12"><div class="panel-card"><h2>Monthly accident records</h2><% if (!byMonth.length) { %><p class="text-muted">No data available.</p><% } %><div class="d-flex flex-wrap gap-2"><% byMonth.forEach(x => { %><div class="month-chip"><strong><%= x.total %></strong><span><%= x._id %></span></div><% }) %></div></div></div></div><%- include('../partials/footer') %>
