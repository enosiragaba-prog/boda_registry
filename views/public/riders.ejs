<%- include('../partials/header', { title }) %><div class="page-heading"><div><div class="eyebrow">PUBLIC DIRECTORY</div><h1>Approved registered riders</h1><p>Only approved records and public profile information are shown.</p></div></div><form class="search-panel mb-4" method="GET"><div class="row g-2"><div class="col-md-9"><input class="form-control form-control-lg" name="q" value="<%= search %>" placeholder="Search by stage or district"></div><div class="col-md-3 d-grid"><button class="btn btn-dark btn-lg">Search directory</button></div></div></form><div class="row g-3"><% if (!riders.length) { %><div class="col-12"><div class="empty-state">No approved riders found. Try another search.</div></div><% } %><% riders.forEach(r => { %><div class="col-md-6 col-lg-4"><div class="rider-public-card"><div class="d-flex justify-content-between"><span class="status-pill">Approved</span><span class="text-muted small">Rider</span></div><h3 class="mt-3"><%= r.publicName ? r.fullName : 'Registered rider' %></h3><div class="text-muted"><%= r.stage || 'Stage not provided' %></div><div class="mt-1"><%= r.district || 'District not provided' %></div></div></div><% }) %></div><%- include('../partials/footer') %>
