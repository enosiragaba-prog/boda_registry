<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> | Boda Registry Uganda</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/style.css"><% if (title === 'Accident map') { %><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"><% } %></head><body>
<nav class="navbar navbar-expand-lg navbar-dark app-nav"><div class="container"><a class="navbar-brand fw-bold" href="/">BODA<span>REGISTRY</span></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="mainNav"><div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
