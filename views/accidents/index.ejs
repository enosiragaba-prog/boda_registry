<%- include('../partials/header', { title }) %>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3"><h1 class="h3">Accident reports</h1><div><a class="btn btn-outline-primary" href="/accidents/map">View map</a> <a class="btn btn-primary" href="/accidents/new">Record accident</a></div></div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0">
<thead><tr><th>Date</th><th>Rider</th><th>Motorcycle</th><th>Location</th><th>District</th><th>Severity</th></tr></thead><tbody>
<% if (!accidents.length) { %><tr><td colspan="6" class="text-center text-muted py-4">No accident reports yet.</td></tr><% } %>
<% accidents.forEach(a => { %><tr><td><%= a.accidentDate.toISOString().slice(0,10) %></td><td><%= a.rider ? a.rider.fullName : '-' %></td><td><%= a.motorcycle ? a.motorcycle.registrationNumber : '-' %></td><td><%= a.locationName %></td><td><%= a.district || '-' %></td><td><%= a.severity %></td></tr><% }) %>
</tbody></table></div></div>
<%- include('../partials/footer') %>
