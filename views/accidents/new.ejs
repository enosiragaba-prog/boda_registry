<%- include('../partials/header', { title }) %>
<div class="form-card"><h1 class="h3 mb-3">Record an accident</h1>
<% if (!riders.length) { %><div class="alert alert-warning">Register a rider before recording an accident. <a href="/riders/new">Register rider</a></div><% } %>
<form method="POST" action="/accidents">
  <div class="row"><div class="col-md-6 mb-3"><label class="form-label">Rider *</label><select class="form-select" name="rider" required><option value="">Choose rider</option><% riders.forEach(r => { %><option value="<%= r._id %>"><%= r.fullName %></option><% }) %></select></div>
  <div class="col-md-6 mb-3"><label class="form-label">Motorcycle</label><select class="form-select" name="motorcycle"><option value="">Not specified</option><% motorcycles.forEach(m => { %><option value="<%= m._id %>"><%= m.registrationNumber %></option><% }) %></select></div></div>
  <div class="row"><div class="col-md-6 mb-3"><label class="form-label">Date and time *</label><input class="form-control" type="datetime-local" name="accidentDate" required></div><div class="col-md-6 mb-3"><label class="form-label">Severity *</label><select class="form-select" name="severity" required><option value="">Choose severity</option><option>Minor</option><option>Serious</option><option>Fatal</option></select></div></div>
  <div class="mb-3"><label class="form-label">Location / road / landmark *</label><input class="form-control" name="locationName" required placeholder="e.g. Wandegeya junction"></div>
  <div class="mb-3"><label class="form-label">District</label><input class="form-control" name="district"></div>
  <p class="small text-muted">Coordinates are optional. They allow the accident to appear on the map. You can add them later.</p>
  <div class="row"><div class="col-md-6 mb-3"><label class="form-label">Latitude</label><input class="form-control" type="number" step="any" name="latitude" min="-90" max="90"></div><div class="col-md-6 mb-3"><label class="form-label">Longitude</label><input class="form-control" type="number" step="any" name="longitude" min="-180" max="180"></div></div>
  <div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="3"></textarea></div>
  <button class="btn btn-primary" <%= !riders.length ? 'disabled' : '' %>>Save accident report</button> <a class="btn btn-outline-secondary" href="/accidents">Cancel</a>
</form></div>
<%- include('../partials/footer') %>
