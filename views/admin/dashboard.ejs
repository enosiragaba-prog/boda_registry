<%- include('../partials/header', { title }) %><div class="page-heading"><div><div class="eyebrow">ADMINISTRATION</div><h1>Registry overview</h1><p>Monitor rider registrations, motorcycles and reported accidents.</p></div><a class="btn btn-accent" href="/admin/riders/new">+ Add rider</a></div><div class="row g-3 mb-4"><div class="col-6 col-lg-3"><div class="metric-card"><div class="metric-label">Approved riders</div><div class="metric-value"><%= stats.riders %></div></div></div><div class="col-6 col-lg-3"><div class="metric-card"><div class="metric-label">Pending review</div><div class="metric-value"><%= stats.pending %></div><a href="/admin/approvals">Review applications →</a></div></div><div class="col-6 col-lg-3"><div class="metric-card"><div class="metric-label">Motorcycles</div><div class="metric-value"><%= stats.motorcycles %></div><a href="/motorcycles">Manage →</a></div></div><div class="col-6 col-lg-3"><div class="metric-card"><div class="metric-label">Accidents recorded</div><div class="metric-value"><%= stats.accidents %></div><a href="/accidents">View reports →</a></div></div></div><div class="panel-card"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="mb-0">Recent accident reports</h2><a href="/accidents">View all</a></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Date</th><th>Rider</th><th>Location</th><th>Severity</th></tr></thead><tbody><% if (!recent.length) { %><tr><td colspan="4" class="text-muted text-center">No accident records yet.</td></tr><% } %><% recent.forEach(a => { %><tr><td><%= a.accidentDate.toISOString().slice(0,10) %></td><td><%= a.rider ? a.rider.fullName : 'Unknown' %></td><td><%= a.locationName %></td><td><span class="badge text-bg-secondary"><%= a.severity %></span></td></tr><% }) %></tbody></table></div></div><%- include('../partials/footer') %>
