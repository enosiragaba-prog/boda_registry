<%- include('../partials/header', { title }) %><div class="page-heading"><div><div class="eyebrow">VERIFICATION QUEUE</div><h1>Registration approvals</h1><p>Review submitted rider details before approving public registration.</p></div></div><div class="row g-3"><% if (!riders.length) { %><div class="col-12"><div class="empty-state">There are no pending applications.</div></div><% } %><% riders.forEach(r => { %><div class="col-lg-6"><div class="panel-card"><div class="d-flex justify-content-between"><h2><%= r.fullName %></h2><span class="status-pill pending-pill">Pending</span></div><p class="text-muted mb-2"><%= r.phone %> · <%= r.district || 'District not provided' %></p><dl class="row small"><dt class="col-5">Stage</dt><dd class="col-7"><%= r.stage || '-' %></dd><dt class="col-5">NIN</dt><dd class="col-7"><%= r.nationalId || 'Not supplied' %></dd><dt class="col-5">Licence</dt><dd class="col-7"><%= r.licenseNumber || 'Not supplied' %></dd><dt class="col-5">Submitted</dt><dd class="col-7"><%= r.createdAt.toISOString().slice(0,10) %></dd></dl><div class="d-flex gap-2"><form method="POST" action="/admin/approvals/<%= r._id %>" onsubmit="return confirm('Approve this rider?')"><input type="hidden" name="status" value="Active"><button class="btn btn-success">Approve</button></form><form method="POST" action="/admin/approvals/<%= r._id %>" onsubmit="return confirm('Reject this application?')"><input type="hidden" name="status" value="Rejected"><button class="btn btn-outline-danger">Reject</button></form></div></div></div><% }) %></div><%- include('../partials/footer') %>
