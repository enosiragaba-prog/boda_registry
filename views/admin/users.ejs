<%- include('../partials/header', { title }) %><div class="page-heading"><div><div class="eyebrow">SECURITY</div><h1>User accounts</h1><p>Administrator and rider accounts in the system.</p></div></div><div class="panel-card table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Created</th></tr></thead><tbody><% users.forEach(u => { %><tr><td><%= u.name %></td><td><%= u.email %></td><td><span class="status-pill"><%= u.role %></span></td><td><%= u.createdAt.toISOString().slice(0,10) %></td></tr><% }) %></tbody></table></div><%- include('../partials/footer') %>
