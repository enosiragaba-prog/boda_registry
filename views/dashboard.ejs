<%- include('partials/header', { title }) %>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
  <div><h1 class="h3 mb-1">Dashboard</h1><p class="text-muted mb-0">Overview of registered riders, motorcycles and accidents.</p></div>
  <a class="btn btn-primary" href="/accidents/new">Record an accident</a>
</div>
<div class="row g-3 mb-4">
  <div class="col-md-4"><div class="stat-card"><div class="text-muted">Registered riders</div><div class="stat-number"><%= stats.riders %></div><a href="/riders">View riders</a></div></div>
  <div class="col-md-4"><div class="stat-card"><div class="text-muted">Motorcycles</div><div class="stat-number"><%= stats.motorcycles %></div><a href="/motorcycles">View motorcycles</a></div></div>
  <div class="col-md-4"><div class="stat-card"><div class="text-muted">Accident reports</div><div class="stat-number"><%= stats.accidents %></div><a href="/accidents">View accidents</a></div></div>
</div>
<div class="card">
  <div class="card-header bg-white fw-semibold">Recent accident reports</div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>Date</th><th>Rider</th><th>Location</th><th>Severity</th></tr></thead>
      <tbody>
      <% if (recentAccidents.length === 0) { %><tr><td colspan="4" class="text-center text-muted py-4">No accident reports yet.</td></tr><% } %>
      <% recentAccidents.forEach(a => { %>
        <tr><td><%= a.accidentDate.toISOString().slice(0,10) %></td><td><%= a.rider ? a.rider.fullName : 'Unknown' %></td><td><%= a.locationName %></td><td><span class="badge text-bg-secondary"><%= a.severity %></span></td></tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('partials/footer') %>
