<%- include('../partials/header', { title }) %><div class="auth-wrap auth-wide"><div class="auth-card"><div class="eyebrow">RIDER ONBOARDING</div><h1>Register as a rider</h1><p class="text-muted">Submit your details for administrator verification. Your account will remain pending until reviewed.</p><% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %><form method="POST" action="/auth/register"><h2 class="form-section-title">Account details</h2><div class="row g-3"><div class="col-md-6"><label class="form-label">Full name *</label><input class="form-control" name="name" required maxlength="100"></div><div class="col-md-6"><label class="form-label">Email address *</label><input class="form-control" type="email" name="email" required></div><div class="col-md-6"><label class="form-label">Password * (minimum 8 characters)</label><input class="form-control" type="password" name="password" minlength="8" required></div><div class="col-md-6"><label class="form-label">Confirm password *</label><input class="form-control" type="password" name="confirmPassword" minlength="8" required></div></div><hr class="my-4"><h2 class="form-section-title">Rider information</h2><div class="row g-3"><div class="col-md-6"><label class="form-label">Phone number *</label><input class="form-control" name="phone" required></div><div class="col-md-6"><label class="form-label">National ID / NIN</label><input class="form-control" name="nationalId" autocomplete="off"></div><div class="col-md-6"><label class="form-label">Riding permit / licence number</label><input class="form-control" name="licenseNumber"></div><div class="col-md-6"><label class="form-label">Boda stage</label><input class="form-control" name="stage"></div><div class="col-md-6"><label class="form-label">District</label><input class="form-control" name="district"></div></div><div class="alert alert-light border mt-4 small">Your NIN and licence number are private and will not appear in the public directory. Only administrators can review them.</div><button class="btn btn-dark btn-lg">Submit registration</button> <a class="btn btn-outline-secondary btn-lg" href="/">Cancel</a></form></div></div><%- include('../partials/footer') %>
