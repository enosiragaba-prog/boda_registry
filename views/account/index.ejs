<%- include('../partials/header', { title }) %><div class="page-heading"><div><div class="eyebrow">RIDER WORKSPACE</div><h1>My rider profile</h1><p>Update your contact and operating details. Identity verification details can only be changed by an administrator.</p></div><span class="status-pill <%= rider.status === 'Active' ? '' : 'pending-pill' %>"><%= rider.status %></span></div><% if (message) { %><div class="alert alert-success"><%= message %></div><% } %><div class="row g-4"><div class="col-lg-8"><div class="panel-card"><form method="POST" action="/account/profile"><div class="row g-3"><div class="col-md-6"><label class="form-label">Full name</label><input class="form-control" value="<%= rider.fullName %>" disabled></div><div class="col-md-6"><label class="form-label">Phone number</label><input class="form-control" name="phone" value="<%= rider.phone %>" required></div><div class="col-md-6"><label class="form-label">Boda stage</label><input class="form-control" name="stage" value="<%= rider.stage || '' %>"></div><div class="col-md-6"><label class="form-label">District</label><input class="form-control" name="district" value="<%= rider.district || '' %>"></div></div><div class="form-check mt-4"><input class="form-check-input" type="checkbox" name="publicName" id="publicName" <%= rider.publicName ? 'checked' : '' %>><label class="form-check-label" for="publicName">I consent to displaying my name in the public rider directory.</label></div><button class="btn btn-dark mt-4">Save changes</button></form></div></div><div class="col-lg-4"><div class="panel-card"><h2>Registration status</h2><p class="text-muted">Your current status is <strong><%= rider.status %></strong>.</p><% if (rider.status === 'Pending') { %><p class="small">The administrator has not yet completed verification. You can update your contact and stage details while waiting.</p><% } else if (rider.status === 'Rejected') { %><p class="small">Contact the registry administrator for further information.</p><% } %></div></div></div><%- include('../partials/footer') %>
